# ─── Influence Trading House — Root .env.example ─────────────────────────────
# Copy this file to .env (never commit .env)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=ith_db
POSTGRES_USER=ith_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5440

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend link (used in password reset emails) ────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google sign in (Google Cloud Console > Credentials > OAuth client ID) ─────
GOOGLE_CLIENT_ID=

# ── Email (leave empty in development: emails print in the terminal) ─────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Influence Trading House <no-reply@yourdomain.com>

# ── Local S3 storage (RustFS in Docker) ──────────────────────────────────────
STORAGE_ACCESS_KEY=ith-dev-change-me
STORAGE_SECRET_KEY=change-me-to-a-long-random-string

# ── File uploads (backend/.env) ──────────────────────────────────────────────
# Local: USE_S3=True with the RustFS keys above. Leave USE_S3=False to save files to backend/media instead.
# AWS: USE_S3=True, no endpoint URL and no keys (the server's IAM role gives access).
USE_S3=False
AWS_STORAGE_BUCKET_NAME=ith-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
