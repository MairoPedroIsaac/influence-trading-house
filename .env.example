# ─── Influence Trading House — Root .env.example ─────────────────────────────
# Copy this file to .env (never commit .env)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=ith_db
POSTGRES_USER=ith_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5440

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend link (used in password reset emails) ────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google sign in (Google Cloud Console > Credentials > OAuth client ID) ─────
GOOGLE_CLIENT_ID=

# ── Email (leave empty in development: emails print in the terminal) ─────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Influence Trading House <no-reply@yourdomain.com>
